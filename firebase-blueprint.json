{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the system (agent, lender, or admin)",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["agent", "lender", "admin"] },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A potential homebuyer lead captured by an agent",
      "type": "object",
      "properties": {
        "agentId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "income": { "type": "number" },
        "householdSize": { "type": "number" },
        "zipCode": { "type": "string" },
        "isFthb": { "type": "boolean" },
        "creditScore": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "eligibility": {
          "type": "array",
          "items": { "type": "object" }
        },
        "status": { "type": "string" },
        "claimedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agentId", "name", "income", "householdSize", "zipCode", "isFthb", "creditScore", "purchasePrice", "createdAt"]
    },
    "Property": {
      "title": "Property",
      "description": "A property listed by an agent",
      "type": "object",
      "properties": {
        "agentId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "address": { "type": "string" },
        "zipCode": { "type": "string" },
        "propertyType": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agentId", "title", "price", "address", "zipCode", "propertyType", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users collection"
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Leads collection"
    },
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Properties collection"
    }
  }
}
